# Copy this file to .env and fill in real values.
# Anything left blank falls back to an honest "not configured" state in the
# app (e.g. console-only email, unscanned files) — it will never fake success.

SECRET_KEY=
DEBUG=True

# ── Real email delivery (password reset, OTP, notifications) ───────────────
# Without these, email is only printed to the backend console, never sent.
# Gmail: use an "app password" (not your normal password) — https://myaccount.google.com/apppasswords
# Or use a free tier from Mailgun / SendGrid / Brevo instead of Gmail.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=CyberSentinel <noreply@cybersentinel.ai>

# ── Real-time (WebSockets via Django Channels) ──────────────────────────────
# Requires a running Redis instance. `docker compose up redis` starts one,
# or install Redis locally. Without it, the app still works over plain REST —
# live push updates are just skipped.
REDIS_URL=redis://localhost:6379/0

# ── File scanning (VirusTotal) ──────────────────────────────────────────────
# Free tier: https://www.virustotal.com/gui/join-us
# Without this, the file scanner returns an honest "unscanned" result instead
# of a real malware verdict — it will never fabricate a scan result.
VIRUSTOTAL_API_KEY=

# ── Real Google OAuth (sign-in + Gmail import) ──────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_OAUTH_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/app/oauth/callback

# ── Phone reputation (optional) ─────────────────────────────────────────────
IPQS_API_KEY=

# Twilio (real SMS delivery) is per-user, not a global env var — connect it
# from within the app under Settings → Integrations.

# ── PostgreSQL (optional — falls back to SQLite if unset) ──────────────────
CYBERSENTINEL_DB_NAME=
CYBERSENTINEL_DB_USER=postgres
CYBERSENTINEL_DB_PASSWORD=
CYBERSENTINEL_DB_HOST=localhost
CYBERSENTINEL_DB_PORT=5432
