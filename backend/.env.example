# Copy this file to backend/.env and fill in real values.
#
# Anything left blank falls back to an honest "not configured" state in the app
# (console-only email, unscanned files, hidden Google button) — it will never
# fake success. See DEPLOYMENT.md for the deployed configuration.

# ── Core ────────────────────────────────────────────────────────────────────
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Required whenever DEBUG is False — the app refuses to start without it.
SECRET_KEY=

# Defaults to False. Never set this to True on a deployed instance: it exposes
# tracebacks, settings, and disables every transport-security header.
DEBUG=True

# Comma-separated hostnames this backend answers to. Required when DEBUG=False.
# On Render the service hostname is added automatically.
ALLOWED_HOSTS=localhost,127.0.0.1

# Where the frontend is served from. Drives CORS, CSRF trust, and the default
# OAuth redirect. In production this is your Vercel URL.
FRONTEND_URL=http://localhost:5173

# Optional overrides — FRONTEND_URL covers the common case on its own.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# Accept Vercel's per-branch preview subdomains (*.vercel.app).
# ALLOW_VERCEL_PREVIEWS=false

LOG_LEVEL=INFO

# ── Database ────────────────────────────────────────────────────────────────
# Preferred: a single connection URL (this is what Render provides).
# Without it the app falls back to a local SQLite file, which is fine for
# development but loses all data on every deploy to an ephemeral host.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Alternative to DATABASE_URL — discrete PostgreSQL settings.
CYBERSENTINEL_DB_NAME=
CYBERSENTINEL_DB_USER=postgres
CYBERSENTINEL_DB_PASSWORD=
CYBERSENTINEL_DB_HOST=localhost
CYBERSENTINEL_DB_PORT=5432

# ── Real-time (WebSockets via Django Channels) ──────────────────────────────
# Requires a running Redis instance; `docker compose up redis` starts one.
# Without it the app still works over plain REST and uses an in-memory channel
# layer — live push just cannot span multiple worker processes.
REDIS_URL=redis://localhost:6379/0

# ── Real email delivery (password reset, OTP, notifications) ────────────────
# Without these, email is only printed to the backend console, never sent.
# Gmail requires an "app password", not your account password:
#   https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=CyberSentinel <noreply@cybersentinel.ai>

# ── Screenshot OCR (cloud) ──────────────────────────────────────────────────
# The Screenshot Analyzer needs OCR. EasyOCR (see requirements-ocr.txt) is the
# best option but needs ~2GB and won't fit small/free hosts. As a lightweight
# alternative, set a free OCR.space API key (https://ocr.space/ocrapi) and the
# scanner uses their cloud OCR instead. Note: with this set, uploaded
# screenshots are sent to ocr.space for processing. Without EasyOCR or this
# key, the scanner honestly reports "OCR unavailable" rather than inventing text.
OCR_SPACE_API_KEY=

# ── File scanning (VirusTotal) ──────────────────────────────────────────────
# Free tier: https://www.virustotal.com/gui/join-us
# Without this the file scanner returns an honest "unscanned" result rather
# than fabricating a malware verdict.
VIRUSTOTAL_API_KEY=

# ── Google OAuth (sign-in + Gmail import) ───────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# The authorised redirect URI must exactly match GOOGLE_OAUTH_REDIRECT_URI.
# In production that is https://<your-vercel-domain>/dashboard/integrations/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/dashboard/integrations/oauth/callback

# ── Microsoft OAuth (sign-in) ───────────────────────────────────────────────
# Register an app at https://entra.microsoft.com (App registrations > New).
# Supported account types: "Accounts in any organizational directory and
# personal Microsoft accounts" (matches the default MICROSOFT_TENANT_ID=common).
# Add a "Single-page application" platform with redirect URI matching FRONTEND_URL.
# No client secret needed — the frontend uses MSAL's public-client auth code
# flow with PKCE and only ever sends the resulting ID token to the backend.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common

# ── Phone reputation (optional) ─────────────────────────────────────────────
# With no key the phone scanner reports "unverified" and relies on community
# reports, rather than implying a number was checked against a threat feed.
IPQS_API_KEY=

# Opt-in fallback that scrapes a third-party reputation site. Off by default:
# it is slow, fragile, and breaks whenever that site changes its markup.
ENABLE_PHONE_REPUTATION_SCRAPE=false

# ── Rate limits ─────────────────────────────────────────────────────────────
# Scanning hits paid APIs and runs OCR, so it is capped well below the general
# allowance. Raise these only if you understand the cost implications.
THROTTLE_ANON=60/hour
THROTTLE_USER=1000/hour
THROTTLE_SCAN_ANON=20/hour
THROTTLE_SCAN_USER=300/hour
THROTTLE_AUTH=20/hour

# ── Transport security (production only, ignored when DEBUG=True) ───────────
# Leave SECURE_SSL_REDIRECT on unless something upstream already terminates TLS
# and redirects for you.
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000

# Twilio (real SMS delivery) is configured per user inside the app, under
# Settings → Integrations — not as a global environment variable.

# ── Credential encryption ───────────────────────────────────────────────────
# Key material for credentials stored recoverably (Twilio tokens, OAuth refresh
# tokens, customer API keys). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# If unset it is derived from SECRET_KEY, which works — but then rotating
# SECRET_KEY makes every stored credential unreadable. Set it explicitly so the
# two rotate independently. Changing it after go-live requires re-entering every
# stored integration credential.
FIELD_ENCRYPTION_KEY=

# ── Rate limits ─────────────────────────────────────────────────────────────
# Outbound SMS costs money and lands on a real phone.
THROTTLE_SMS=20/hour
# Unauthenticated form posts (contact requests, scam reports).
THROTTLE_PUBLIC_WRITE=15/hour

# ── Upload and scan limits ──────────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760
MAX_SCAN_TEXT_CHARS=20000
