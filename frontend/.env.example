# Copy to frontend/.env for local development.
#
# Every VITE_* value is inlined into the JavaScript bundle at build time and is
# therefore PUBLIC. Never put an API secret, client secret, or private key here
# — anything in this file is readable by anyone who loads the site.
#
# On Vercel, set these under Project → Settings → Environment Variables. They
# are read at build time, so changing one requires a redeploy to take effect.

# ── Backend API ─────────────────────────────────────────────────────────────
# Local:      http://localhost:8000/api
# Production: https://cybersentinel-api.onrender.com/api
VITE_API_URL=http://localhost:8000/api

# WebSocket origin for live notifications, dashboard, and threat feed.
# Same host as the API, but with the ws:// or wss:// scheme.
# Production MUST use wss:// — a browser on an https:// page refuses ws://.
VITE_WS_URL=ws://localhost:8000

# ── Site metadata (used for SEO tags and canonical URLs) ────────────────────
VITE_SITE_URL=http://localhost:5173
VITE_SITE_NAME=CyberSentinel

# ── Optional ────────────────────────────────────────────────────────────────
# Google Analytics measurement ID. Leave blank to disable analytics entirely.
VITE_GA_ID=

# Google OAuth *client ID* only — public by design, never the client secret.
# Leave blank and the frontend fetches it from the backend's /config/public/
# endpoint instead, which is the preferred route.
VITE_GOOGLE_CLIENT_ID=

# Microsoft Entra ID *application (client) ID* only — public by design, no
# secret involved (MSAL's browser flow uses PKCE, not a client secret).
# Register at https://entra.microsoft.com; see backend/.env.example for the
# matching MICROSOFT_CLIENT_ID/MICROSOFT_TENANT_ID the backend verifies against.
VITE_MICROSOFT_CLIENT_ID=
