# Environment & local data
# Real secrets live in .env files; only the .env.example templates are tracked.
.env
*.env
*.env.local
backend/.env
frontend/.env
frontend/.env.*
!*.env.example
!.env.example
db/
tmp/
*.pdf

# Python
backend/__pycache__/
backend/*/__pycache__/
backend/api/migrations/__pycache__/
backend/db.sqlite3
backend/media/

# Build & runtime artefacts (regenerated by build.sh / collectstatic)
backend/staticfiles/
backend/ml_models/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
venv/
.venv/
env/

# Node/React
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / System
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
